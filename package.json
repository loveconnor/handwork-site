{
  "name": "handwork-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "dev": "node scripts/prepare.mjs && next dev --hostname 127.0.0.1 --port ${PORT:-4321}",
    "preview": "node scripts/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:hydration": "node tests/hydration.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "honestui": "^0.2.3",
    "motion": "^12.43.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
